{
	"name": "@blacktiger/tmdb",
	"description": "TMDB SDK",
	"version": "0.23.1",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"lint": "prettier src --check && eslint src/**/*.{js,ts}",
		"format": "prettier --write src",
