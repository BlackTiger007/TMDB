	"license": "MIT",
	"bugs": {
		"url": "https://github.com/BlackTiger007/tmdb/issues"
	},
	"homepage": "https://github.com/BlackTiger007/tmdb#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^24.13.2",
		"@vitest/coverage-v8": "^4.1.9",
		"dotenv": "^17.4.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.7.0",
		"prettier": "^3.9.4",
		"semantic-release": "^25.0.5",
		"ts-node": "^10.9.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^4.1.9"
	}
